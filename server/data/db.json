  "templates": [
    {
      "id": "tpl-201",
      "title": "Simple Welcome Email",
      "category": "Transactional",
      "subject": "Welcome to FlowEM! Here is how to get started",
      "previewText": "A quick guide to sending your first email in under 5 minutes.",
      "thumbnail": "welcome",
      "updatedAt": "2026-11-08",
      "isPopular": true,
      "htmlContent": "<!DOCTYPE html>\n<html>\n<head><meta charset=\"utf-8\"><title>Welcome</title></head>\n<body style=\"background-color: #f8fafc; font-family: 'Cambria Math', Cambria, Georgia, serif; color: #1e293b; padding: 40px 20px;\">\n  <table width=\"600\" align=\"center\" style=\"background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 32px; box-shadow: 0 4px 6px rgba(0,0,0,0.05);\">\n    <tr>\n      <td>\n        <h2 style=\"color: #4f46e5; margin-top: 0; font-size: 24px;\">Welcome to FlowEM</h2>\n        <p style=\"font-size: 15px; line-height: 1.6; color: #334155;\">Hello {{firstName}},</p>\n        <p style=\"font-size: 15px; line-height: 1.6; color: #334155;\">Thank you for joining FlowEM. You can now send bulk emails to your customers, create automated follow-up steps, and make sure your messages land straight into the Inbox.</p>\n        <div style=\"background-color: #f1f5f9; border-left: 4px solid #4f46e5; padding: 16px; margin: 24px 0; border-radius: 4px;\">\n          <p style=\"margin: 0; font-size: 14px; color: #1e293b; font-weight: bold;\">Quick Checklist to Send Today:</p>\n          <p style=\"margin: 6px 0 0; font-size: 13px; color: #475569;\">1. Add your contacts list<br>2. Choose an email template<br>3. Hit Send!</p>\n        </div>\n        <p style=\"font-size: 14px; line-height: 1.6; color: #475569;\">If you need any help, our support team is ready to answer your questions.</p>\n        <p style=\"font-size: 12px; color: #94a3b8; margin-top: 32px; border-top: 1px solid #e2e8f0; padding-top: 16px;\">FlowEM Inc. 100 Montgomery St, San Francisco, CA. You received this email because you signed up on our website.</p>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>"
    },
    {
      "id": "tpl-202",
      "title": "Company Monthly Newsletter",
      "category": "Newsletter",
      "subject": "This Month at FlowEM: New Features and Helpful Tips",
      "previewText": "Read about our latest platform updates and fast sending tools.",
      "thumbnail": "newsletter",
      "updatedAt": "2026-11-04",
      "isPopular": true,
      "htmlContent": "<!DOCTYPE html>\n<html>\n<head><meta charset=\"utf-8\"><title>Monthly Newsletter</title></head>\n<body style=\"background-color: #f8fafc; font-family: 'Cambria Math', Cambria, Georgia, serif; color: #1e293b; padding: 40px 20px;\">\n  <table width=\"600\" align=\"center\" style=\"background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 32px;\">\n    <tr>\n      <td>\n        <span style=\"font-size: 12px; font-weight: bold; text-transform: uppercase; color: #4f46e5;\">Monthly Update</span>\n        <h2 style=\"color: #0f172a; margin: 8px 0 16px;\">What is New in FlowEM</h2>\n        <p style=\"font-size: 15px; line-height: 1.6; color: #334155;\">Here are the main improvements we shipped this month to make your email sending faster and simpler:</p>\n        <table width=\"100%\" style=\"margin: 20px 0;\">\n          <tr>\n            <td style=\"padding: 16px; background-color: #f1f5f9; border-radius: 8px; text-align: center;\">\n              <div style=\"font-size: 26px; font-weight: bold; color: #4f46e5;\">99.8%</div>\n              <div style=\"font-size: 12px; color: #64748b;\">Inbox Success Rate</div>\n            </td>\n            <td width=\"16\"></td>\n            <td style=\"padding: 16px; background-color: #f1f5f9; border-radius: 8px; text-align: center;\">\n              <div style=\"font-size: 26px; font-weight: bold; color: #10b981;\">Fast</div>\n              <div style=\"font-size: 12px; color: #64748b;\">Instant Delivery</div>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>"
    },
    {
      "id": "tpl-203",
      "title": "Simple Payment Receipt",
      "category": "Transactional",
      "subject": "Your payment receipt #FLW-884920",
      "previewText": "Thank you for your payment. Here are the order details.",
      "thumbnail": "receipt",
      "updatedAt": "2026-10-28",
      "isPopular": false,
      "htmlContent": "<!DOCTYPE html>\n<html>\n<head><meta charset=\"utf-8\"><title>Payment Receipt</title></head>\n<body style=\"background-color: #f8fafc; font-family: 'Cambria Math', Cambria, Georgia, serif; color: #1e293b; padding: 40px 20px;\">\n  <table width=\"600\" align=\"center\" style=\"background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 32px;\">\n    <tr>\n      <td>\n        <h3 style=\"color: #0f172a; margin-top: 0;\">Payment Received</h3>\n        <p style=\"color: #64748b; font-size: 14px;\">Order Number: FLW-884920</p>\n        <hr style=\"border: none; border-top: 1px solid #e2e8f0; margin: 16px 0;\">\n        <table width=\"100%\" style=\"font-size: 14px; color: #334155;\">\n          <tr>\n            <td style=\"padding: 6px 0;\">FlowEM Monthly Plan (2,500,000 Emails)</td>\n            <td align=\"right\" style=\"font-weight: bold;\">$1,850.00</td>\n          </tr>\n          <tr>\n            <td style=\"padding: 6px 0;\">Dedicated Clean IPs (x4)</td>\n            <td align=\"right\" style=\"font-weight: bold;\">$240.00</td>\n          </tr>\n          <tr style=\"border-top: 1px solid #e2e8f0;\">\n            <td style=\"padding: 12px 0; font-weight: bold; color: #0f172a;\">Total Paid</td>\n            <td align=\"right\" style=\"padding: 12px 0; font-weight: bold; color: #10b981; font-size: 16px;\">$2,090.00</td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>"
    }
  ],
  "automations": [
    {
      "id": "wf-401",
      "name": "Welcome Series for New Signups",
      "description": "Sends a welcome message immediately, waits 2 days, and sends helpful tips.",
      "status": "Active",
      "triggerType": "Contact Added",
      "totalEnrolled": 8420,
      "completedCount": 7890,
      "avgConversionRate": 46.2,
      "updatedAt": "Today",
      "steps": [
        {
          "id": "st-1",
          "type": "trigger",
          "title": "Trigger: New Contact Added to List",
          "subtitle": "Starts as soon as someone joins the New Customers list",
          "config": {
            "listId": "lst-01"
          }
        },
        {
          "id": "st-2",
          "type": "email",
          "title": "Action: Send Welcome Email",
          "subtitle": "Uses Simple Welcome Email template",
          "config": {
            "templateId": "tpl-201"
          }
        },
        {
          "id": "st-3",
          "type": "delay",
          "title": "Wait: 2 Days",
          "subtitle": "Gives the reader time to read the first email",
          "config": {
            "days": 2
          }
        },
        {
          "id": "st-4",
          "type": "condition",
          "title": "Check: Did they open the first email?",
          "subtitle": "If yes, tag them as Engaged. If no, send a reminder.",
          "config": {
            "condition": "opened"
          }
        },
        {
          "id": "st-5",
          "type": "tag",
          "title": "Action: Add Tag \"Engaged Customer\"",
          "subtitle": "Marks contact for future special offers",
          "config": {
            "tag": "Engaged Customer"
          }
        }
      ]
    },
    {
      "id": "wf-402",
      "name": "Re-engage Inactive Subscribers",
      "description": "Finds contacts who have not opened emails in 90 days and checks if they still want updates.",
      "status": "Active",
      "triggerType": "Tag Applied",
      "totalEnrolled": 19430,
      "completedCount": 16200,
      "avgConversionRate": 18.4,
      "updatedAt": "Yesterday",
      "steps": [
        {
          "id": "st-11",
          "type": "trigger",
          "title": "Trigger: Contact marked Inactive (90 Days)",
          "subtitle": "Identified by automated monthly check",
          "config": {
            "tag": "Inactive-90"
          }
        },
        {
          "id": "st-12",
          "type": "email",
          "title": "Action: Send \"Do you still want emails?\"",
          "subtitle": "Allows them to stay subscribed or unsubscribe easily",
          "config": {
            "templateId": "tpl-202"
          }
        },
        {
          "id": "st-13",
          "type": "delay",
          "title": "Wait: 7 Days",
          "subtitle": "Waiting for their answer or click",
          "config": {
            "days": 7
          }
        },
        {
          "id": "st-14",
          "type": "condition",
          "title": "Check: Still no opens or clicks?",
          "subtitle": "Safeguards your domain from sending to dead emails",
          "config": {
            "condition": "no-open"
          }
        },
        {
          "id": "st-15",
          "type": "tag",
          "title": "Action: Move to Blocked List",
          "subtitle": "Stops sending future campaigns to avoid spam flags",
          "config": {
            "tag": "Auto-Suppressed"
          }
        }
      ]
    }
  ],
