// FlowEM Database Schema
// Database Engine: MySQL 8 exclusively
// ORM: Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. IDENTITY & ACCESS CONTROL (RBAC)
// ==========================================

model User {
  id               String       @id @default(uuid())
  email            String       @unique @db.VarChar(191)
  passwordHash     String       @db.VarChar(255)
  name             String       @db.VarChar(100)
  status           String       @default("Active") @db.VarChar(20) // Active, Suspended, Invited
  twoFactorEnabled Boolean      @default(false)
  twoFactorSecret  String?      @db.VarChar(255)
  lastLoginAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  roles            UserRole[]
  sessions         Session[]
  auditLogs        AuditLog[]
  notifications    Notification[]

  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique @db.VarChar(50) // Owner, Admin, Campaign Creator, Analyst, Viewer
  description String           @db.VarChar(255)
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())

  users       UserRole[]
  permissions RolePermission[]
  invitations Invitation[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique @db.VarChar(50) // e.g. campaigns:create, contacts:export
  name        String           @db.VarChar(100)
  module      String           @db.VarChar(50) // campaigns, contacts, templates, etc.
  description String           @db.VarChar(255)

  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique @db.VarChar(255)
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Invitation {
  id        String   @id @default(uuid())
  email     String   @db.VarChar(191)
  roleId    String
  invitedBy String?  @db.VarChar(100)
  token     String   @unique @db.VarChar(255)
  status    String   @default("Pending") @db.VarChar(20) // Pending, Accepted, Expired
  expiresAt DateTime
  createdAt DateTime @default(now())

  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@map("invitations")
}

// ==========================================
// 2. CONTACTS & AUDIENCE SEGMENTATION
// ==========================================

model Contact {
  id           String               @id @default(uuid())
  email        String               @unique @db.VarChar(191)
  firstName    String?              @db.VarChar(100)
  lastName     String?              @db.VarChar(100)
  phone        String?              @db.VarChar(30)
  status       String               @default("Active") @db.VarChar(20) // Active, Unsubscribed, Bounced, Complained
  source       String?              @default("Manual") @db.VarChar(50) // Manual, CSV, API, Webhook
  consentGiven Boolean              @default(true)
  consentDate  DateTime?
  consentIp    String?              @db.VarChar(45)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  listMembers  ContactListMember[]
  tags         ContactTag[]
  customFields ContactCustomField[]
  consentLogs  ConsentRecord[]
  recipients   CampaignRecipient[]

  @@index([status])
  @@index([createdAt])
  @@map("contacts")
}

model ContactList {
  id          String              @id @default(uuid())
  name        String              @db.VarChar(150)
  description String?             @db.Text
  type        String              @default("Static") @db.VarChar(20) // Static, Dynamic
  rulesJson   Json?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  members     ContactListMember[]
  campaigns   Campaign[]

  @@map("contact_lists")
}

model ContactListMember {
  id        String      @id @default(uuid())
  contactId String
  listId    String
  addedAt   DateTime    @default(now())

  contact   Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  list      ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([contactId, listId])
  @@map("contact_list_members")
}

model Tag {
  id        String       @id @default(uuid())
  name      String       @unique @db.VarChar(50)
  createdAt DateTime     @default(now())

  contacts  ContactTag[]

  @@map("tags")
}

model ContactTag {
  id        String   @id @default(uuid())
  contactId String
  tagId     String

  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([contactId, tagId])
  @@map("contact_tags")
}

model ContactCustomField {
  id        String   @id @default(uuid())
  contactId String
  key       String   @db.VarChar(50)
  value     String   @db.Text

  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, key])
  @@map("contact_custom_fields")
}

model ConsentRecord {
  id          String   @id @default(uuid())
  contactId   String
  consentType String   @db.VarChar(50) // marketing_email, transactional, event_notice
  ipAddress   String?  @db.VarChar(45)
  userAgent   String?  @db.Text
  evidence    String?  @db.Text
  recordedAt  DateTime @default(now())

  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@map("consent_records")
}

model ImportJob {
  id           String   @id @default(uuid())
  filename     String   @db.VarChar(255)
  totalRows    Int      @default(0)
  importedRows Int      @default(0)
  failedRows   Int      @default(0)
  status       String   @default("Processing") @db.VarChar(20) // Processing, Completed, Failed
  errorsJson   Json?
  createdAt    DateTime @default(now())

  @@map("import_jobs")
}

// ==========================================
// 3. TEMPLATES & EMAIL DESIGN
// ==========================================

model Template {
  id           String            @id @default(uuid())
  name         String            @db.VarChar(150)
  subject      String            @db.VarChar(255)
  previewText  String?           @db.VarChar(255)
  category     String            @default("Newsletter") @db.VarChar(50)
  editorJson   Json?
  htmlContent  String            @db.LongText
  isPopular    Boolean           @default(false)
  thumbnailUrl String?           @db.VarChar(255)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  versions     TemplateVersion[]
  campaigns    Campaign[]

  @@map("templates")
}

model TemplateVersion {
  id            String   @id @default(uuid())
  templateId    String
  versionNumber Int
  htmlContent   String   @db.LongText
  editorJson    Json?
  createdAt     DateTime @default(now())

  template      Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("template_versions")
}

model TemplateCategory {
  id   String @id @default(uuid())
  name String @unique @db.VarChar(50)
  slug String @unique @db.VarChar(50)

  @@map("template_categories")
}

// ==========================================
// 4. CAMPAIGNS & BULK TRANSMISSION
// ==========================================

model Campaign {
  id                 String              @id @default(uuid())
  name               String              @db.VarChar(150)
  subject            String              @db.VarChar(255)
  previewText        String?             @db.VarChar(255)
  senderName         String              @db.VarChar(100)
  senderEmail        String              @db.VarChar(191)
  replyToEmail       String?             @db.VarChar(191)
  templateId         String?
  listId             String?
  status             String              @default("Draft") @db.VarChar(20) // Draft, Scheduled, Preparing, Sending, Paused, Completed, Failed, Cancelled
  scheduledAt        DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  recipientsTotal    Int                 @default(0)
  sentCount          Int                 @default(0)
  deliveredCount     Int                 @default(0)
  openedCount        Int                 @default(0)
  clickedCount       Int                 @default(0)
  bouncedCount       Int                 @default(0)
  complainedCount    Int                 @default(0)
  unsubscribedCount  Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  template           Template?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  list               ContactList?        @relation(fields: [listId], references: [id], onDelete: SetNull)
  recipients         CampaignRecipient[]
  campaignEvents     CampaignEvent[]
  schedules          CampaignSchedule[]

  @@index([status])
  @@index([createdAt])
  @@map("campaigns")
}

model CampaignRecipient {
  id           String    @id @default(uuid())
  campaignId   String
  contactId    String?
  email        String    @db.VarChar(191)
  status       String    @default("Pending") @db.VarChar(20) // Pending, Queued, Sent, Delivered, Bounced, Failed
  sesMessageId String?   @db.VarChar(191)
  sentAt       DateTime?
  deliveredAt  DateTime?
  errorMessage String?   @db.Text

  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact      Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([campaignId, email])
  @@index([status])
  @@map("campaign_recipients")
}

model CampaignEvent {
  id         String   @id @default(uuid())
  campaignId String
  eventType  String   @db.VarChar(50) // created, scheduled, started, paused, resumed, completed
  dataJson   Json?
  createdAt  DateTime @default(now())

  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("campaign_events")
}

model EmailEvent {
  id             String   @id @default(uuid())
  messageId      String   @db.VarChar(191)
  campaignId     String?  @db.VarChar(36)
  contactId      String?  @db.VarChar(36)
  eventType      String   @db.VarChar(50) // Sent, Delivered, Bounce, Complaint, Open, Click
  recipientEmail String   @db.VarChar(191)
  ipAddress      String?  @db.VarChar(45)
  userAgent      String?  @db.Text
  linkUrl        String?  @db.Text
  timestamp      DateTime @default(now())
  rawPayload     Json?

  @@index([messageId])
  @@index([campaignId])
  @@index([eventType])
  @@map("email_events")
}

model CampaignSchedule {
  id            String   @id @default(uuid())
  campaignId    String
  timeZone      String   @default("UTC") @db.VarChar(50)
  scheduledTime DateTime
  status        String   @default("Scheduled") @db.VarChar(20)

  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("campaign_schedules")
}

// ==========================================
// 5. INFRASTRUCTURE & DOMAINS (AWS SES)
// ==========================================

model SenderDomain {
  id              String           @id @default(uuid())
  domain          String           @db.VarChar(191)
  subdomain       String           @unique @db.VarChar(191)
  status          String           @default("Pending") @db.VarChar(20) // Pending, Verified, Failed
  spfStatus       String           @default("Checking") @db.VarChar(20)
  dkimStatus      String           @default("Checking") @db.VarChar(20)
  dmarcStatus     String           @default("Checking") @db.VarChar(20)
  dkimTokensJson  Json?
  warmupStage     String           @default("Stage 1") @db.VarChar(50)
  dailyQuotaLimit Int              @default(500)
  dailySentCount  Int              @default(0)
  reputationScore Int              @default(100)
  verifiedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  identities      SenderIdentity[]

  @@map("sender_domains")
}

model SenderIdentity {
  id         String       @id @default(uuid())
  email      String       @unique @db.VarChar(191)
  name       String       @db.VarChar(100)
  domainId   String?
  isVerified Boolean      @default(false)
  createdAt  DateTime     @default(now())

  domain     SenderDomain? @relation(fields: [domainId], references: [id], onDelete: SetNull)

  @@map("sender_identities")
}

model SendingConfiguration {
  id             String   @id @default(uuid())
  maxSendingRate Int      @default(14) // max emails per second on SES
  defaultRegion  String   @default("ap-south-1") @db.VarChar(50)
  hourlyLimit    Int      @default(10000)
  updatedAt      DateTime @updatedAt

  @@map("sending_configurations")
}

// ==========================================
// 6. SUPPRESSION & COMPLIANCE
// ==========================================

model Suppression {
  id             String   @id @default(uuid())
  email          String   @unique @db.VarChar(191)
  reason         String   @db.VarChar(50) // Hard Bounce, Spam Complaint, Unsubscribe Request, Manual Policy
  sourceCampaign String?  @db.VarChar(150)
  notes          String?  @db.Text
  suppressedAt   DateTime @default(now())

  @@index([reason])
  @@map("suppressions")
}

model UnsubscribeEvent {
  id         String   @id @default(uuid())
  email      String   @db.VarChar(191)
  campaignId String?  @db.VarChar(36)
  ipAddress  String?  @db.VarChar(45)
  reason     String?  @db.VarChar(255)
  createdAt  DateTime @default(now())

  @@index([email])
  @@map("unsubscribe_events")
}

// ==========================================
// 7. AUTOMATION & EVENT-DRIVEN FLOWS
// ==========================================

model Automation {
  id             String                @id @default(uuid())
  name           String                @db.VarChar(150)
  description    String?               @db.Text
  triggerType    String                @default("contact_signup") @db.VarChar(50) // contact_signup, list_join, campaign_event, tag_added
  status         String                @default("Draft") @db.VarChar(20) // Draft, Active, Paused
  totalEnrolled  Int                   @default(0)
  completedCount Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  steps          AutomationStep[]
  executions     AutomationExecution[]

  @@map("automations")
}

model AutomationStep {
  id           String         @id @default(uuid())
  automationId String
  stepOrder    Int
  type         String         @db.VarChar(30) // trigger, email, delay, condition, tag
  title        String         @db.VarChar(150)
  subtitle     String?        @db.VarChar(255)
  configJson   Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  automation   Automation     @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId, stepOrder])
  @@map("automation_steps")
}

model AutomationExecution {
  id            String                    @id @default(uuid())
  automationId  String
  contactId     String
  currentStepId String?                   @db.VarChar(36)
  status        String                    @default("Running") @db.VarChar(20) // Running, Completed, Paused, Failed
  enrolledAt    DateTime                  @default(now())
  completedAt   DateTime?

  automation    Automation                @relation(fields: [automationId], references: [id], onDelete: Cascade)
  stepLogs      AutomationExecutionStep[]

  @@map("automation_executions")
}

model AutomationExecutionStep {
  id          String              @id @default(uuid())
  executionId String
  stepId      String
  status      String              @default("Success") @db.VarChar(20)
  executedAt  DateTime            @default(now())
  outputJson  Json?

  execution   AutomationExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@map("automation_execution_steps")
}

// ==========================================
// 8. ORGANIZATION & DEVELOPER API
// ==========================================

model OrganizationSettings {
  id               String   @id @default(uuid())
  companyName      String   @default("Brainovision Solutions India Pvt Ltd") @db.VarChar(150)
  companyAddress   String   @default("Hyderabad, Telangana, India") @db.Text
  complianceContact String  @default("compliance@brainovision.in") @db.VarChar(191)
  timeZone         String   @default("Asia/Kolkata") @db.VarChar(50)
  monthlyQuota     Int      @default(100000)
  currentUsage     Int      @default(0)
  planName         String   @default("Enterprise High-Throughput") @db.VarChar(50)
  enforceTwoFactor Boolean  @default(false)
  webhookUrl       String?  @db.VarChar(255)
  updatedAt        DateTime @updatedAt

  @@map("organization_settings")
}

model ApiKey {
  id         String    @id @default(uuid())
  name       String    @db.VarChar(100)
  keyHash    String    @unique @db.VarChar(255)
  prefix     String    @db.VarChar(32) // e.g. flw_live_a8f9
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("api_keys")
}

model Webhook {
  id          String            @id @default(uuid())
  url         String            @db.VarChar(255)
  secret      String            @db.VarChar(255)
  eventsJson  Json
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())

  deliveries  WebhookDelivery[]

  @@map("webhooks")
}

model WebhookDelivery {
  id             String    @id @default(uuid())
  webhookId      String
  eventType      String    @db.VarChar(50)
  payloadJson    Json
  responseStatus Int?
  responseBody   String?   @db.Text
  deliveredAt    DateTime  @default(now())

  webhook        Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@map("webhook_deliveries")
}

// ==========================================
// 9. AUDITING, RELIABILITY & OUTBOX
// ==========================================

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  action       String   @db.VarChar(100)
  resourceType String   @db.VarChar(50)
  resourceId   String?  @db.VarChar(36)
  detailsJson  Json?
  ipAddress    String?  @db.VarChar(45)
  createdAt    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  title     String   @db.VarChar(150)
  message   String   @db.Text
  type      String   @default("info") @db.VarChar(20) // info, warning, success, error
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("notifications")
}

model OutboxEvent {
  id            String    @id @default(uuid())
  aggregateType String    @db.VarChar(50) // Campaign, Contact, Automation
  aggregateId   String    @db.VarChar(36)
  eventType     String    @db.VarChar(50) // campaign.queued, email.send_requested
  payloadJson   Json
  status        String    @default("Pending") @db.VarChar(20) // Pending, Published, Failed
  retryCount    Int       @default(0)
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?

  @@index([status, createdAt])
  @@map("outbox_events")
}

model IdempotencyRecord {
  id           String   @id @default(uuid())
  key          String   @unique @db.VarChar(191)
  resourceType String   @db.VarChar(50)
  resourceId   String?  @db.VarChar(36)
  createdAt    DateTime @default(now())

  @@map("idempotency_records")
}
