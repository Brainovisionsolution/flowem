# FlowEM Environment Configuration
PORT=5000
NODE_ENV=production
APP_URL=https://flowem.brainovision.in
CLIENT_URL=https://flowem.brainovision.in

# MySQL 8 Database Connection (Prisma)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://flowem_user:FlowemSecret2026!@localhost:3306/flowem_db"

# JWT Authentication Secrets
JWT_SECRET="replace_with_a_secure_random_64_character_hex_string"
JWT_EXPIRES_IN="7d"

# Single Admin Account Configuration
ADMIN_EMAIL="admin@brainovision.in"
ADMIN_PASSWORD="Admin@Flowem2026!"

# AWS SES Configuration (Brainovision Sending Identity)
AWS_REGION="ap-south-1"
SES_DEFAULT_FROM_EMAIL="notifications@mail.brainovision.in"
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"

# Redis & Queue Configuration (BullMQ)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""
