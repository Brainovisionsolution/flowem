# FlowEM Environment Configuration
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MySQL 8 Database Configuration (Pure MySQL 8 Driver)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=flowem_db
DATABASE_URL="mysql://root:YOUR_MYSQL_PASSWORD@127.0.0.1:3306/flowem_db"

# JWT Authentication Secrets
JWT_SECRET="replace_with_a_secure_random_64_character_hex_string"
JWT_EXPIRES_IN="7d"

# FlowEM Dashboard Admin Credentials (Use these to log into the web UI)
ADMIN_EMAIL="admin@brainovision.in"
ADMIN_PASSWORD="YOUR_ADMIN_PASSWORD"

# AWS SES v2 Configuration (Brainovision Sending Identity)
AWS_REGION="us-east-1"
AWS_SES_FROM_EMAIL="it@brainovision.in"
SES_DEFAULT_FROM_EMAIL="it@brainovision.in"
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"

# Redis & Queue Configuration
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""
